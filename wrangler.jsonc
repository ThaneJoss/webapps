{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webapps",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "build": {
    "command": "pnpm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
