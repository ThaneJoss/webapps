{
  "name": "waas-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.21.0 || ^26.10.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run build:ssg",
    "build:ssg": "vite-ssg build && node scripts/harden-build.mjs",
    "check:dependencies": "pnpm outdated",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.native.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@iconify-json/solar": "1.2.5",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@unocss/preset-wind3": "66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.64.0",
    "unocss": "66.7.5",
    "unplugin-icons": "23.0.1",
    "vite": "8.1.5",
    "vite-ssg": "28.3.0",
    "vitest": "4.1.11"
  }
}
