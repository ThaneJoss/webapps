{
  "name": "waas-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.21.0 || ^26.10.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run build:ssg",
    "build:ssg": "vite-ssg build && node scripts/harden-build.mjs",
    "check:dependencies": "pnpm outdated",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "typecheck": "pnpm run typecheck:native && pnpm run typecheck:vue",
    "typecheck:native": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.native.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@iconify-json/solar": "1.2.13",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@unocss/preset-wind3": "66.10.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "unocss": "66.10.5",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.4",
    "vite-ssg": "28.3.0",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
